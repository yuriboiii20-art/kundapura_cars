# Firebase Configuration for Kundapura Cars
# You can also configure this directly inside the Admin Panel -> "Cloud Sync & Database" tab.
# To configure in Vercel: Project Settings -> Environment Variables

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=kundapura-cars.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kundapura-cars
VITE_FIREBASE_STORAGE_BUCKET=kundapura-cars.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcd1234efgh
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
